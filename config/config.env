# ====================================================
# Arquivo de configuração - Desafio da Baseline
# ====================================================
# Variáveis de ambiente utilizadas pela aplicação.
# Não inclua dados sensíveis aqui em projetos reais.

# Identificação da aplicação
APP_NAME=Calculadora Baseline
APP_VERSION=1.0.0

# Ambiente: development | staging | production
APP_ENV=development

# Modo de depuração (true/false)
DEBUG=true

# Configurações de logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Locale e timezone
LOCALE=pt_BR
TIMEZONE=America/Sao_Paulo
